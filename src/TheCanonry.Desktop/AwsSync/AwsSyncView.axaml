<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:aws="using:TheCanonry.Desktop.AwsSync"
             x:Class="TheCanonry.Desktop.AwsSync.AwsSyncView"
             x:DataType="aws:AwsSyncViewModel">
    <DockPanel>
        <!-- Config Form -->
        <Border DockPanel.Dock="Top" Padding="16,12"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Spacing="8">
                <TextBlock Text="AWS S3 Sync" FontSize="18" FontWeight="SemiBold" />

                <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto" Margin="0,4">
                    <TextBlock Grid.Column="0" Text="Bucket:" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Grid.Column="1" Text="{Binding BucketName}" Watermark="my-bucket" Margin="0,0,16,0" />
                    <TextBlock Grid.Column="2" Text="Prefix:" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Grid.Column="3" Text="{Binding Prefix}" Watermark="images/" />
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Test Connection" Command="{Binding TestConnectionCommand}" />
                    <Button Content="Sync Images" Command="{Binding SyncImagesCommand}" Classes="accent" />
                    <Button Content="Upload Catalog" Command="{Binding UploadCatalogCommand}" />

                    <TextBlock Text="{Binding ConnectionStatus}" VerticalAlignment="Center" Margin="12,0" Opacity="0.7" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Progress -->
        <Border DockPanel.Dock="Top" Padding="16,8"
                IsVisible="{Binding IsUploading}">
            <StackPanel Spacing="4">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding SyncProgress, StringFormat='{}{0:F0}%'}" />
                    <TextBlock Text="Syncing..." />
                </DockPanel>
                <ProgressBar Value="{Binding SyncProgress}" Maximum="100" Height="12" />
                <TextBlock Text="{Binding ImageCount, StringFormat='{}{0} images processed'}"
                           FontSize="11" Opacity="0.6" />
            </StackPanel>
        </Border>

        <!-- Sync Log -->
        <DockPanel Margin="16">
            <TextBlock DockPanel.Dock="Top" Text="Sync Log" FontWeight="SemiBold" Margin="0,0,0,8"
                       FontSize="11" Opacity="0.6" />
            <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                    CornerRadius="4" Padding="8">
                <ScrollViewer>
                    <TextBlock Text="{Binding SyncLog}" FontFamily="Cascadia Code,Consolas,monospace"
                               FontSize="12" TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>
        </DockPanel>
    </DockPanel>
</UserControl>

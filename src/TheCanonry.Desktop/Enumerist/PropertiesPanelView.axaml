<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pg="using:Avalonia.PropertyGrid.Controls"
             xmlns:en="using:TheCanonry.Desktop.Enumerist"
             x:Class="TheCanonry.Desktop.Enumerist.PropertiesPanelView"
             x:DataType="en:EnumeristViewModel">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Padding="8,4"
                   FontSize="11" Opacity="0.6"
                   Text="Select an item to view its properties"
                   IsVisible="{Binding SelectionService.SelectedObject, Converter={x:Static ObjectConverters.IsNull}}" />
        <pg:PropertyGrid DataContext="{Binding SelectionService.SelectedObject}" />
    </DockPanel>
</UserControl>

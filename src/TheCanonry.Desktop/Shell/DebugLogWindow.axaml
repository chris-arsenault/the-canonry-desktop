<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TheCanonry.Desktop.Shell.DebugLogWindow"
        Title="Debug Log" Width="800" Height="500"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <Button Content="Copy to Clipboard" Click="CopyToClipboard_Click" Padding="12,6" />
            <Button Content="Refresh" Click="Refresh_Click" Padding="12,6" />
        </StackPanel>
        <TextBox x:Name="LogText"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 FontFamily="Cascadia Code,Consolas,monospace"
                 FontSize="12"
                 TextWrapping="NoWrap" />
    </DockPanel>
</Window>

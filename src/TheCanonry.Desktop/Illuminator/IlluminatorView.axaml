<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:illum="using:TheCanonry.Desktop.Illuminator"
             x:Class="TheCanonry.Desktop.Illuminator.IlluminatorView"
             x:DataType="illum:IlluminatorViewModel">
    <DockPanel>
        <!-- Header Stats -->
        <Border DockPanel.Dock="Top" Padding="16,12"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}" Margin="8,0,0,0" />
                <Button DockPanel.Dock="Right" Content="Clear Completed" Command="{Binding ClearCompletedCommand}" />
                <StackPanel Orientation="Horizontal" Spacing="24">
                    <StackPanel>
                        <TextBlock Text="Queue" FontSize="11" Opacity="0.6" />
                        <TextBlock Text="{Binding QueueLength}" FontSize="20" FontWeight="Bold" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Active" FontSize="11" Opacity="0.6" />
                        <TextBlock Text="{Binding ActiveJobCount}" FontSize="20" FontWeight="Bold" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Total Cost" FontSize="11" Opacity="0.6" />
                        <TextBlock Text="{Binding TotalCost, StringFormat='${0:F4}'}" FontSize="20" FontWeight="Bold" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Job List and Detail -->
        <Grid ColumnDefinitions="*,350">
            <!-- Job List -->
            <ListBox Grid.Column="0" ItemsSource="{Binding EnrichmentJobs}"
                     SelectedItem="{Binding SelectedJob}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="illum:EnrichmentJobItem">
                        <DockPanel Margin="4,4">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Opacity="0.7"
                                       VerticalAlignment="Center" Margin="8,0" />
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding EstimatedCost, StringFormat='${0:F4}'}"
                                       Opacity="0.5" VerticalAlignment="Center" />
                            <StackPanel>
                                <TextBlock Text="{Binding TaskType}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding TargetEntityId}" FontSize="12" Opacity="0.6" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Detail Panel -->
            <Border Grid.Column="1"
                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                    BorderThickness="1,0,0,0"
                    Padding="16"
                    IsVisible="{Binding SelectedJob, Converter={x:Static ObjectConverters.IsNotNull}}">
                <StackPanel Spacing="8" DataContext="{Binding SelectedJob}">
                    <TextBlock Text="Job Detail" FontWeight="SemiBold" FontSize="16" />

                    <TextBlock Text="Task Type" FontSize="11" Opacity="0.6" />
                    <TextBlock Text="{Binding TaskType}" />

                    <TextBlock Text="Entity" FontSize="11" Opacity="0.6" />
                    <TextBlock Text="{Binding TargetEntityId}" />

                    <TextBlock Text="Status" FontSize="11" Opacity="0.6" />
                    <TextBlock Text="{Binding Status}" />

                    <TextBlock Text="Queued At" FontSize="11" Opacity="0.6" />
                    <TextBlock Text="{Binding QueuedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" />

                    <TextBlock Text="Cost" FontSize="11" Opacity="0.6" />
                    <TextBlock Text="{Binding EstimatedCost, StringFormat='${0:F4}'}" />

                    <TextBlock Text="{Binding ProgressMessage}" Opacity="0.7"
                               IsVisible="{Binding ProgressMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />

                    <ProgressBar Value="{Binding ProgressFraction}" Maximum="1.0" Height="8" Margin="0,4"
                                 IsVisible="{Binding ProgressFraction, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>

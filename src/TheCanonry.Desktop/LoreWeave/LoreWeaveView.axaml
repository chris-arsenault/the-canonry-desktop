<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lw="using:TheCanonry.Desktop.LoreWeave"
             x:Class="TheCanonry.Desktop.LoreWeave.LoreWeaveView"
             x:DataType="lw:LoreWeaveViewModel">
    <Grid ColumnDefinitions="280,*" RowDefinitions="*,200">
        <!-- Config Panel (Left) -->
        <Border Grid.Column="0" Grid.RowSpan="2"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="0,0,1,0"
                Padding="16">
            <StackPanel Spacing="12">
                <TextBlock Text="Simulation Config" FontWeight="SemiBold" FontSize="16" />

                <TextBlock Text="Config Path" FontSize="11" Opacity="0.6" />
                <TextBox Text="{Binding ConfigPath}" Watermark="Path to domain config..." />

                <Button Content="Load Config" Command="{Binding LoadConfigCommand}" HorizontalAlignment="Stretch" />

                <Separator Margin="0,8" />

                <TextBlock Text="Max Ticks" FontSize="11" Opacity="0.6" />
                <NumericUpDown Value="{Binding MaxTicks}" Minimum="10" Maximum="10000" Increment="50" />

                <TextBlock Text="Scale Factor" FontSize="11" Opacity="0.6" />
                <NumericUpDown Value="{Binding ScaleFactor}" Minimum="0.1" Maximum="10" Increment="0.1"
                               FormatString="F1" />

                <Separator Margin="0,8" />

                <Button Content="Run Simulation" Command="{Binding RunSimulationCommand}"
                        HorizontalAlignment="Stretch" Classes="accent" />
                <Button Content="Stop" Command="{Binding StopSimulationCommand}"
                        HorizontalAlignment="Stretch" />
            </StackPanel>
        </Border>

        <!-- Progress Area (Center) -->
        <Border Grid.Column="1" Grid.Row="0" Padding="16">
            <StackPanel Spacing="16" VerticalAlignment="Center" MaxWidth="600">
                <TextBlock Text="Lore Weave" FontSize="20" FontWeight="SemiBold"
                           HorizontalAlignment="Center" />

                <TextBlock Text="{Binding StatusMessage}" HorizontalAlignment="Center" FontSize="14" Opacity="0.8" />

                <ProgressBar Value="{Binding Progress}" Maximum="100" Height="20" />

                <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" Margin="0,8">
                    <TextBlock Grid.Column="0" Grid.Row="0" Text="Tick" FontSize="11" Opacity="0.6"
                               HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="1" Grid.Row="0" Text="Entities" FontSize="11" Opacity="0.6"
                               HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="2" Grid.Row="0" Text="Relationships" FontSize="11" Opacity="0.6"
                               HorizontalAlignment="Center" />

                    <TextBlock Grid.Column="0" Grid.Row="1" Text="{Binding CurrentTick}" FontSize="24"
                               FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding EntityCount}" FontSize="24"
                               FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="2" Grid.Row="1" Text="{Binding RelationshipCount}" FontSize="24"
                               FontWeight="Bold" HorizontalAlignment="Center" />
                </Grid>

                <TextBlock Text="{Binding CurrentEra, StringFormat='Era: {0}'}" FontSize="14"
                           HorizontalAlignment="Center" Opacity="0.7" />
            </StackPanel>
        </Border>

        <!-- Log Output (Bottom) -->
        <Border Grid.Column="1" Grid.Row="1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Log" FontWeight="SemiBold" Margin="8,8,8,4"
                           FontSize="11" Opacity="0.6" />
                <ScrollViewer>
                    <TextBlock Text="{Binding LogOutput}" FontFamily="Cascadia Code,Consolas,monospace"
                               FontSize="12" Margin="8,0" TextWrapping="Wrap" />
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
